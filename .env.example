# ReceiptBuddy Environment Configuration
# Copy this to .env and adjust for your setup
#
# All values shown are defaults that work with Docker Compose.
# For local development, update URLs to point to localhost.

# ─── APPLICATION ──────────────────────────────────
APP_NAME=ReceiptBuddy
VERSION=1.0.0
DEBUG=true

# ─── DATABASE ─────────────────────────────────────
DATABASE_URL=postgresql://receiptbuddy:receiptbuddy123@localhost:5432/receiptbuddy
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── REDIS ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── MICROSERVICE URLs (for internal routing) ─────
AUTH_SERVICE_URL=http://auth:8001
FINANCE_SERVICE_URL=http://finance:8002
HR_SERVICE_URL=http://hr:8003
INTELLIGENCE_SERVICE_URL=http://intelligence:8004

# ─── MINIO (S3-compatible storage) ────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=receiptbuddy
MINIO_SECRET_KEY=receiptbuddy123
MINIO_BUCKET=receipts

# ─── QDRANT (Vector database) ─────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# ─── OLLAMA (Local LLM) ──────────────────────────
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.3
EMBEDDING_MODEL=nomic-embed-text-v1.5

# ─── CORS ─────────────────────────────────────────
CORS_ORIGINS=["*"]

# ─── PGADMIN (optional) ──────────────────────────
PGADMIN_EMAIL=admin@receiptbuddy.com
PGADMIN_PASSWORD=admin
